# Copy to site.env (chmod 600) for `bash deploy/publish-site.sh cloudflare`.
SITE_DOMAIN=example.org
IMG_BASE=https://img.example.org/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_PAGES_PROJECT=paperfigure
R2_BUCKET=paperfigure-figs
# SITE_DOMAIN: the site's domain (a Cloudflare zone). IMG_BASE: public URL prefix of the figure bucket, ends with /.
# CLOUDFLARE_API_TOKEN needs Pages:Edit, R2:Edit and DNS:Edit (DNS only for deploy/cf-setup.py).
# deploy/cf-setup.py appends R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / CF_ZONE_ID, derived from the token.
